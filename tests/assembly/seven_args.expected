# c-tds: seven_args.ctds
        .text
ctds_s7:                        # func s7(a, b, c, d, e, f, g)
        pushq   %rbp
        movq    %rsp, %rbp
        subq    $64, %rsp       # 8 posiciones = 64 bytes -> 64
        movl    %edi, -8(%rbp)  # a
        movl    %esi, -16(%rbp) # b
        movl    %edx, -24(%rbp) # c
        movl    %ecx, -32(%rbp) # d
        movl    %r8d, -40(%rbp) # e
        movl    %r9d, -48(%rbp) # f
        movl    16(%rbp), %r10d
        movl    %r10d, -56(%rbp) # g (de la pila)
        # t1 = a + g
        movl    -8(%rbp), %r10d
        addl    -56(%rbp), %r10d
        movl    %r10d, -64(%rbp)
        # ret t1
        movl    -64(%rbp), %eax
        leave
        ret

        .globl  main
main:                           # func main()
        pushq   %rbp
        movq    %rsp, %rbp
        subq    $16, %rsp       # 1 posicion = 8 bytes -> 16
        # param 1
        # param 2
        # param 3
        # param 4
        # param 5
        # param 6
        # param 7
        # t1 = call s7, 7
        subq    $8, %rsp        # alineacion de la pila
        movl    $7, %r10d
        pushq   %r10
        movl    $1, %edi
        movl    $2, %esi
        movl    $3, %edx
        movl    $4, %ecx
        movl    $5, %r8d
        movl    $6, %r9d
        call    ctds_s7
        addq    $16, %rsp
        movl    %eax, -8(%rbp)
        # ret t1
        movl    -8(%rbp), %eax
        leave
        ret

        .section .note.GNU-stack,"",@progbits
